---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProductoDetalle from '../../components/ProductoDetalle.jsx';
const { id } = Astro.params;
export function getStaticPaths() {
  return [1, 2, 3, 4, 5, 6].map((id) => ({ params: { id: String(id) } }));
}
---
<Layout title="Ficha de producto | Multiventas JL"><Navbar /><main class="page-shell"><ProductoDetalle productoId={id} client:load /></main></Layout>
